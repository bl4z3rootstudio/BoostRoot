<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BoostRoot.ViewModels"
        xmlns:v="using:BoostRoot.App.Views"
        xmlns:loc="using:BoostRoot.ViewModels.Localization"
        x:Class="BoostRoot.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BoostRoot" Icon="avares://BoostRoot/Assets/boostroot.ico"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><v:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:ScanViewModel"><v:ScanView /></DataTemplate>
    <DataTemplate DataType="vm:NetViewModel"><v:NetView /></DataTemplate>
    <DataTemplate DataType="vm:ToolsViewModel"><v:ToolsView /></DataTemplate>
    <DataTemplate DataType="vm:StressViewModel"><v:StressView /></DataTemplate>
    <DataTemplate DataType="vm:FpsViewModel"><v:FpsView /></DataTemplate>
    <DataTemplate DataType="vm:ClipsViewModel"><v:ClipsView /></DataTemplate>
    <DataTemplate DataType="vm:PlaceholderViewModel"><v:PlaceholderView /></DataTemplate>
  </Window.DataTemplates>
  <Panel>
  <DockPanel>
    <!-- Sidebar -->
    <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource Sidebar}" BorderBrush="#221E33" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,0,14,20">
        <Border DockPanel.Dock="Top" Height="78" Background="Transparent" PointerPressed="OnDragArea">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="8,14,0,0">
            <Image Source="avares://BoostRoot/Assets/logo-256.png" Width="38" Height="38" />
            <TextBlock FontFamily="{StaticResource HeadFont}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
              <Run Text="Boost" /><Run Text="Root" Foreground="{StaticResource AccentLight}" />
            </TextBlock>
          </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="11" Margin="8,12,0,0"
                   Text="{Binding [app.tagline], Source={x:Static loc:Loc.I}}" />
        <ItemsControl ItemsSource="{Binding Nav}" Margin="0,8,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItemViewModel">
              <Button Classes="nav" Classes.active="{Binding IsActive}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
                  <TextBlock Text="{Binding Title}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>
    <!-- Title bar -->
    <Grid DockPanel.Dock="Top" Height="36" ColumnDefinitions="*,Auto">
      <Border Background="Transparent" PointerPressed="OnDragArea" DoubleTapped="OnToggleMaximize" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Classes="chrome" Click="OnMinimize" ToolTip.Tip="−"><PathIcon Data="M4 12h16" Width="10" Height="10" /></Button>
        <Button Classes="chrome" Click="OnToggleMaximize" ToolTip.Tip="□"><PathIcon Data="M4 4h16v16H4z" Width="10" Height="10" /></Button>
        <Button Classes="chrome close" Click="OnClose" ToolTip.Tip="×"><PathIcon Data="M5 5l14 14M19 5L5 19" Width="10" Height="10" /></Button>
      </StackPanel>
    </Grid>
    <ContentControl Content="{Binding CurrentPage}" />
  </DockPanel>
  <!-- First run -->
  <Border IsVisible="{Binding ShowWelcome}" Background="#E60B0912">
    <Border Classes="card" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36">
      <StackPanel Spacing="16">
        <Image Source="avares://BoostRoot/Assets/logo-256.png" Width="72" Height="72" HorizontalAlignment="Left" />
        <TextBlock Classes="h1" FontSize="30" Text="{Binding [welcome.title], Source={x:Static loc:Loc.I}}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [welcome.sub], Source={x:Static loc:Loc.I}}" />
        <StackPanel Spacing="10">
          <TextBlock TextWrapping="Wrap"><Run Text="✓  " Foreground="{StaticResource Good}" /><Run Text="{Binding [welcome.p1], Source={x:Static loc:Loc.I}}" /></TextBlock>
          <TextBlock TextWrapping="Wrap"><Run Text="✓  " Foreground="{StaticResource Good}" /><Run Text="{Binding [welcome.p2], Source={x:Static loc:Loc.I}}" /></TextBlock>
          <TextBlock TextWrapping="Wrap"><Run Text="✓  " Foreground="{StaticResource Good}" /><Run Text="{Binding [welcome.p3], Source={x:Static loc:Loc.I}}" /></TextBlock>
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding [welcome.lang], Source={x:Static loc:Loc.I}}" />
          <ComboBox Grid.Column="1" Width="120" HorizontalAlignment="Left" ItemsSource="{Binding Settings.Languages}" SelectedItem="{Binding Settings.Language}" />
          <Button Grid.Column="2" Classes="primary" Command="{Binding FinishWelcomeCommand}" Content="{Binding [welcome.start], Source={x:Static loc:Loc.I}}" />
        </Grid>
      </StackPanel>
    </Border>
  </Border>
  </Panel>
</Window>
