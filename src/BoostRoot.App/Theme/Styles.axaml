<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Bg}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
    <Setter Property="FontSize" Value="44" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="Foreground" Value="{StaticResource AccentLight}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.5" />
  </Style>
  <!-- Sidebar nav buttons -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{StaticResource NavActive}" />
    <Setter Property="Foreground" Value="#E9D5FF" />
  </Style>
  <!-- Level pills -->
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.pill.selected">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="#0B0A12" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.pill.selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentLight}" />
    <Setter Property="Foreground" Value="#0B0A12" />
  </Style>
  <!-- Primary / secondary -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="#0B0A12" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="22,12" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentLight}" />
    <Setter Property="Foreground" Value="#0B0A12" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,10" />
  </Style>
  <!-- Big round BOOST button -->
  <!-- BOOST: animated orb (rotating ring + breathing glow + press feedback) -->
  <Style Selector="Button.boost">
    <Setter Property="Width" Value="240" />
    <Setter Property="Height" Value="240" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.boost:pointerover"><Setter Property="RenderTransform" Value="scale(1.05)" /></Style>
  <Style Selector="Button.boost:pressed"><Setter Property="RenderTransform" Value="scale(0.94)" /></Style>
  <Style Selector="Button.boost:disabled"><Setter Property="Opacity" Value="0.85" /></Style>
  <Style Selector="Ellipse.orbRing">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Style.Animations>
      <Animation Duration="0:0:6" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Ellipse.orbRing.fast">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Ellipse.orbGlow">
    <Style.Animations>
      <Animation Duration="0:0:2.4" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /><Setter Property="ScaleTransform.ScaleX" Value="0.92" /><Setter Property="ScaleTransform.ScaleY" Value="0.92" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.75" /><Setter Property="ScaleTransform.ScaleX" Value="1.04" /><Setter Property="ScaleTransform.ScaleY" Value="1.04" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="PathIcon.rocket">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="2" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="-4" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Game cover tiles -->
  <Style Selector="Button.cover">
    <Setter Property="Height" Value="190" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.cover.selected">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.cover.dim">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <!-- Title bar buttons -->
  <Style Selector="Button.chrome">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="#17122A" />
    <Setter Property="BorderBrush" Value="#2E2647" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#3B1F66" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <!-- ===== Light motion everywhere ===== -->
  <Style Selector="Button.primary, Button.ghost, Button.pill, Button.nav, Button.chip, ToggleButton.chip, Button.cover">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.primary:pressed, Button.ghost:pressed, Button.pill:pressed, Button.chip:pressed, ToggleButton.chip:pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>
  <Style Selector="Button.primary:pointerover, Button.pill:pointerover"><Setter Property="RenderTransform" Value="scale(1.03)" /></Style>
  <Style Selector="Button.nav:pointerover"><Setter Property="RenderTransform" Value="translateX(3px)" /></Style>
  <Style Selector="Button.cover:pointerover"><Setter Property="RenderTransform" Value="scale(1.04)" /></Style>
  <Style Selector="Button.cover:pressed"><Setter Property="RenderTransform" Value="scale(0.97)" /></Style>
  <Style Selector="Button.cover.selected"><Setter Property="RenderTransform" Value="scale(1.02)" /></Style>
  <!-- Cards and rows fade in when they appear -->
  <Style Selector="Border.card">
    <Style.Animations>
      <Animation Duration="0:0:0.35" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.cover">
    <Style.Animations>
      <Animation Duration="0:0:0.4" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="TextBlock.pop">
    <Style.Animations>
      <Animation Duration="0:0:0.45" Easing="BackEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.6" /><Setter Property="ScaleTransform.ScaleY" Value="0.6" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Transitions"><Transitions><DoubleTransition Property="Value" Duration="0:0:0.3" Easing="CubicEaseOut" /></Transitions></Setter>
  </Style>
  <Style Selector="Button.star">
    <Setter Property="Background" Value="#99000000" />
    <Setter Property="Foreground" Value="#80FFFFFF" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="BackEaseOut" /></Transitions></Setter>
  </Style>
  <Style Selector="Button.star.on"><Setter Property="Foreground" Value="#FACC15" /><Setter Property="RenderTransform" Value="scale(1.12)" /></Style>
  <Style Selector="Button.star:pointerover"><Setter Property="RenderTransform" Value="scale(1.2)" /></Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>
  <Style Selector="Border.appRow">
    <Setter Property="Background" Value="#14111F" />
    <Setter Property="BorderBrush" Value="#2A2340" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.2" /><BrushTransition Property="BorderBrush" Duration="0:0:0.2" /></Transitions></Setter>
  </Style>
  <Style Selector="Border.appRow.on"><Setter Property="Background" Value="#2A1650" /><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>
  <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{TemplateBinding Background}" />
    <Setter Property="BorderBrush" Value="White" />
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" /></Transitions></Setter>
  </Style>
  <Style Selector="Button.swatch:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.12)" />
  </Style>
  <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="{StaticResource Bad}" /></Style>
</Styles>
