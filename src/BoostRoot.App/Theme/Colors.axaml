<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#0B0A12</Color>
  <Color x:Key="SurfaceColor">#14121F</Color>
  <Color x:Key="Surface2Color">#1C1830</Color>
  <Color x:Key="BorderColor">#2A2540</Color>
  <Color x:Key="AccentColor">#A855F7</Color>
  <Color x:Key="AccentLightColor">#C084FC</Color>
  <Color x:Key="TextColor">#EDEBF5</Color>
  <Color x:Key="MutedColor">#A19DB5</Color>
  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
  <SolidColorBrush x:Key="Sidebar" Color="#100E19" />
  <SolidColorBrush x:Key="Hero" Color="#120E1C" />
  <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentLight" Color="{StaticResource AccentLightColor}" />
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="NavActive" Color="#241D3D" />
  <SolidColorBrush x:Key="Good" Color="#86EFAC" />
  <SolidColorBrush x:Key="Warn" Color="#FCD34D" />
  <SolidColorBrush x:Key="Bad" Color="#F87171" />
  <FontFamily x:Key="BodyFont">avares://BoostRoot/Assets/Fonts#Inter</FontFamily>
  <FontFamily x:Key="HeadFont">avares://BoostRoot/Assets/Fonts#Space Grotesk</FontFamily>
</ResourceDictionary>
