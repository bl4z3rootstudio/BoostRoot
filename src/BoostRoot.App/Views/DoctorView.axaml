<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BoostRoot.ViewModels" xmlns:loc="using:BoostRoot.ViewModels.Localization"
             x:Class="BoostRoot.App.Views.DoctorView" x:DataType="vm:DoctorViewModel">
  <ScrollViewer>
    <StackPanel Margin="48,24" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" FontSize="32" Text="{Binding [doc.title], Source={x:Static loc:Loc.I}}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [doc.sub], Source={x:Static loc:Loc.I}}" />
      </StackPanel>
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
          <TextBlock VerticalAlignment="Center" Text="{Binding [doc.pick], Source={x:Static loc:Loc.I}}" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:DoctorGameChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="2" Classes="primary" Command="{Binding ScanCommand}" Content="{Binding [doc.scan], Source={x:Static loc:Loc.I}}" />
          <Button Grid.Column="3" Classes="ghost" Command="{Binding FixAllCommand}" IsVisible="{Binding HasFixable}" Content="{Binding [doc.fixAll], Source={x:Static loc:Loc.I}}" />
        </Grid>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
        <TextBlock Classes="pop" FontSize="18" FontWeight="Bold" Text="{Binding Summary}" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Findings}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DoctorFindingViewModel">
            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Panel Width="22" VerticalAlignment="Top" Margin="0,2,0,0">
                  <PathIcon Data="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm-1 5v7h2V7zm0 9v2h2v-2z" Width="20" Height="20" Foreground="{StaticResource Warn}" IsVisible="{Binding IsProblem}" />
                  <PathIcon Data="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm-1.2 13.6 6.9-6.9-1.4-1.4-5.5 5.5-2.5-2.5-1.4 1.4z" Width="20" Height="20" Foreground="{StaticResource Good}" IsVisible="{Binding IsOk}" />
                  <PathIcon Data="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm-1 8v7h2v-7zm0-4v2h2V6z" Width="20" Height="20" Foreground="{StaticResource AccentLight}" IsVisible="{Binding IsInfo}" />
                </Panel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Text="{Binding Title}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Detail}" />
                  <Border IsVisible="{Binding HasManual}" Background="#1AFFFFFF" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding [doc.howTo], Source={x:Static loc:Loc.I}}" />
                      <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Manual}" />
                    </StackPanel>
                  </Border>
                  <TextBlock FontSize="12" Foreground="{StaticResource Good}" Text="{Binding Result}" IsVisible="{Binding Result, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding Busy}" Foreground="{StaticResource Accent}" />
                  <Button Classes="primary" IsVisible="{Binding ShowFix}" Content="{Binding [doc.fix], Source={x:Static loc:Loc.I}}"
                          Command="{Binding $parent[ItemsControl].((vm:DoctorViewModel)DataContext).FixCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
