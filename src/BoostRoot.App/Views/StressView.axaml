<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BoostRoot.ViewModels" xmlns:loc="using:BoostRoot.ViewModels.Localization"
             xmlns:c="using:BoostRoot.App.Controls" xmlns:s="using:BoostRoot.Core.Stress"
             x:Class="BoostRoot.App.Views.StressView" x:DataType="vm:StressViewModel">
  <ScrollViewer>
    <StackPanel Margin="48,24" Spacing="16">
      <TextBlock Classes="h1" FontSize="32" Text="{Binding [nav.stress], Source={x:Static loc:Loc.I}}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [stress.note], Source={x:Static loc:Loc.I}}" />
      <Grid ColumnDefinitions="*,*" IsEnabled="{Binding !IsRunning}">
        <StackPanel Spacing="8" Margin="0,0,16,0">
          <TextBlock Classes="h2" Text="{Binding [stress.what], Source={x:Static loc:Loc.I}}" />
          <ItemsControl ItemsSource="{Binding Kinds}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KindChoice">
                <ToggleButton Classes="chip" Margin="0,0,8,8" IsChecked="{Binding IsSelected, Mode=OneWay}" Content="{Binding Title}"
                              Command="{Binding $parent[ItemsControl].((vm:StressViewModel)DataContext).ChooseKindCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Classes="h2" Text="{Binding [stress.howLong], Source={x:Static loc:Loc.I}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ItemsControl ItemsSource="{Binding Presets}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MinutesChoice">
                  <ToggleButton Classes="chip" Margin="0,0,8,0" IsChecked="{Binding IsSelected, Mode=OneWay}" Content="{Binding Title}"
                                Command="{Binding $parent[ItemsControl].((vm:StressViewModel)DataContext).ChoosePresetCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <NumericUpDown Value="{Binding CustomMinutes}" Minimum="1" Maximum="600" Width="120" FormatString="0" />
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding [stress.minutes], Source={x:Static loc:Loc.I}}" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="primary" Command="{Binding StartCommand}" Content="{Binding [stress.start], Source={x:Static loc:Loc.I}}" />
        <Button Classes="ghost" Command="{Binding StopCommand}" Content="{Binding [stress.stop], Source={x:Static loc:Loc.I}}" />
        <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="{Binding Elapsed}" />
      </StackPanel>
      <ProgressBar Value="{Binding Progress}" Maximum="1" Foreground="{StaticResource Accent}" />
      <UniformGrid Columns="3">
        <Border Classes="card" Margin="0,0,12,0"><StackPanel><TextBlock Classes="muted" Text="{Binding [stress.cpu], Source={x:Static loc:Loc.I}}" /><TextBlock FontWeight="SemiBold" Text="{Binding CpuText}" /></StackPanel></Border>
        <Border Classes="card" Margin="0,0,12,0"><StackPanel><TextBlock Classes="muted" Text="{Binding [stress.gpu], Source={x:Static loc:Loc.I}}" /><TextBlock FontWeight="SemiBold" Text="{Binding GpuText}" /></StackPanel></Border>
        <Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="{Binding [stress.ram], Source={x:Static loc:Loc.I}}" /><TextBlock FontWeight="SemiBold" Text="{Binding RamText}" /></StackPanel></Border>
      </UniformGrid>
      <UniformGrid Columns="3" Height="170">
        <Border Classes="card" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding [stress.chartTemp], Source={x:Static loc:Loc.I}}" /><c:LineChart Values="{Binding TempSeries}" Max="100" Stroke="#F87171" /></DockPanel></Border>
        <Border Classes="card" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding [stress.chartLoad], Source={x:Static loc:Loc.I}}" /><c:LineChart Values="{Binding LoadSeries}" Max="100" Stroke="#C084FC" /></DockPanel></Border>
        <Border Classes="card"><DockPanel><TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding [stress.chartRate], Source={x:Static loc:Loc.I}}" /><c:LineChart Values="{Binding RateSeries}" Max="100" Stroke="#86EFAC" /></DockPanel></Border>
      </UniformGrid>
      <Border Classes="card" IsVisible="{Binding ResultTitle, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="6">
          <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Good}" IsVisible="{Binding ResultOk}" Text="{Binding ResultTitle}" />
          <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Bad}" IsVisible="{Binding !ResultOk}" Text="{Binding ResultTitle}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding ResultDetail}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
