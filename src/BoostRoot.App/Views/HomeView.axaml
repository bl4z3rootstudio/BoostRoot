<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BoostRoot.ViewModels"
             xmlns:loc="using:BoostRoot.ViewModels.Localization"
             xmlns:local="using:BoostRoot.App"
             x:Class="BoostRoot.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <DockPanel>
    <!-- Hero -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Hero}" BorderBrush="#221E33" BorderThickness="0,0,0,1" Padding="48,24,48,32">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="12" VerticalAlignment="Center">
          <TextBlock Classes="eyebrow" Text="{Binding [home.selected], Source={x:Static loc:Loc.I}}" />
          <TextBlock Classes="h1" Text="{Binding Selected.Name, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted" FontSize="15" Text="{Binding [home.untouched], Source={x:Static loc:Loc.I}}" />
          <ItemsControl ItemsSource="{Binding Levels}" Margin="0,6,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LevelOptionViewModel">
                <Button Classes="pill" Classes.selected="{Binding IsSelected}" Margin="0,0,8,8"
                        ToolTip.Tip="{Binding Description}"
                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ChooseLevelCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="★" IsVisible="{Binding IsRecommended}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" Text="{Binding RecommendedText}" />
          <TextBlock Classes="muted" Text="{Binding PlaytimeText}" IsVisible="{Binding PlaytimeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Spacing="2" IsVisible="{Binding CanStretch}">
            <CheckBox IsChecked="{Binding IsStretched}" Content="{Binding [home.stretch], Source={x:Static loc:Loc.I}}" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Text="{Binding [home.stretchNote], Source={x:Static loc:Loc.I}}" />
          </StackPanel>
          <Expander Header="{Binding [share.title], Source={x:Static loc:Loc.I}}" MaxWidth="620" HorizontalAlignment="Left" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="8">
              <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding ShareCommand}" Content="{Binding [share.copy], Source={x:Static loc:Loc.I}}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ShareInput}" Watermark="{Binding [share.paste], Source={x:Static loc:Loc.I}}" />
                <Button Grid.Column="1" Classes="primary" Command="{Binding ImportShareCommand}" Content="{Binding [share.apply], Source={x:Static loc:Loc.I}}" />
              </Grid>
              <TextBlock Classes="pop" Foreground="{StaticResource Good}" Text="{Binding ShareStatus}" />
            </StackPanel>
          </Expander>
          <Expander Header="{Binding [home.whatChanges], Source={x:Static loc:Loc.I}}" MaxWidth="620" HorizontalAlignment="Left" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding NoFileChanges}" Text="{Binding [home.noFileChanges], Source={x:Static loc:Loc.I}}" />
              <ItemsControl ItemsSource="{Binding Changes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChangeRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock TextWrapping="Wrap" Text="{Binding Text}" />
                      <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource Good}" IsVisible="{Binding High}" Text="{Binding Impact}" />
                      <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="11" Classes="muted" IsVisible="{Binding !High}" Text="{Binding Impact}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="eyebrow" Margin="0,6,0,0" IsVisible="{Binding Tips, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding [home.tips], Source={x:Static loc:Loc.I}}" />
              <TextBlock TextWrapping="Wrap" Text="{Binding Tips}" IsVisible="{Binding Tips, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Expander>
          <!-- Status + post-boost actions -->
          <Border Classes="card" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" Padding="14,10" MaxWidth="620" HorizontalAlignment="Left">
            <StackPanel Spacing="10">
              <TextBlock Classes="pop" Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
              <ItemsControl ItemsSource="{Binding ResultSteps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StepRow">
                    <TextBlock Classes="pop" Margin="0,2" TextWrapping="Wrap">
                      <Run Text="{Binding Icon}" Foreground="{StaticResource Good}" /><Run Text="  " /><Run Text="{Binding Text}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AskLaunch}">
                <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding [boost.launchAsk], Source={x:Static loc:Loc.I}}" />
                <Button Classes="primary" Command="{Binding LaunchCommand}" Content="{Binding [boost.launchYes], Source={x:Static loc:Loc.I}}" />
                <Button Classes="ghost" Command="{Binding DismissLaunchCommand}" Content="{Binding [boost.launchNo], Source={x:Static loc:Loc.I}}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding UndoCommand}"
                  IsVisible="{Binding LastOperation, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Content="{Binding [boost.undo], Source={x:Static loc:Loc.I}}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="boost" Margin="32,0,0,0" Command="{Binding BoostCommand}" ToolTip.Tip="{Binding [home.boostTip], Source={x:Static loc:Loc.I}}">
          <Grid Width="240" Height="240">
            <!-- breathing glow -->
            <Ellipse Classes="orbGlow" Width="230" Height="230" RenderTransformOrigin="50%,50%">
              <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.55" />
                  <GradientStop Color="#00A855F7" Offset="1" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <!-- rotating gradient ring -->
            <Ellipse Classes="orbRing" Classes.fast="{Binding IsBusy}" Width="196" Height="196" StrokeThickness="5" RenderTransformOrigin="50%,50%">
              <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
              <Ellipse.Stroke>
                <ConicGradientBrush>
                  <GradientStop Color="#F0ABFC" Offset="0" />
                  <GradientStop Color="{DynamicResource AccentColor}" Offset="0.35" />
                  <GradientStop Color="#3B1F66" Offset="0.7" />
                  <GradientStop Color="#F0ABFC" Offset="1" />
                </ConicGradientBrush>
              </Ellipse.Stroke>
            </Ellipse>
            <!-- core -->
            <Ellipse Width="180" Height="180">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                  <GradientStop Color="#5B21B6" Offset="0.6" />
                  <GradientStop Color="#2E1065" Offset="1" />
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="180" Height="180" StrokeThickness="1" Stroke="#40FFFFFF" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2" IsVisible="{Binding !IsBusy}">
              <PathIcon Classes="rocket" Width="40" Height="40" Foreground="White" Data="M12 2c3 2 5 6 5 10l2 3-3 1-1 3h-6l-1-3-3-1 2-3c0-4 2-8 5-10zm0 6a2 2 0 1 0 0 4 2 2 0 0 0 0-4z">
                <PathIcon.RenderTransform><TranslateTransform /></PathIcon.RenderTransform>
              </PathIcon>
              <TextBlock Text="{Binding [home.boost], Source={x:Static loc:Loc.I}}" FontFamily="{StaticResource HeadFont}" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" LetterSpacing="2" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" IsVisible="{Binding IsBusy}">
              <TextBlock Text="{Binding [boost.running], Source={x:Static loc:Loc.I}}" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Button>
      </Grid>
    </Border>
    <!-- Game grid -->
    <DockPanel Margin="48,24,48,24">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,14">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="h2" Text="{Binding GamesTitle}" />
          <TextBlock Classes="muted" FontSize="11" Text="{Binding LibraryText}" />
        </StackPanel>
        <TextBox Grid.Column="2" Width="240" Margin="0,0,12,0" Text="{Binding SearchText}" Watermark="{Binding [home.search], Source={x:Static loc:Loc.I}}" />
        <ToggleSwitch Grid.Column="3" IsChecked="{Binding ShowAll}" OnContent="{Binding [home.showAll], Source={x:Static loc:Loc.I}}" OffContent="{Binding [home.showAll], Source={x:Static loc:Loc.I}}" />
      </Grid>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Games}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GameCardViewModel">
              <Button Classes="cover" Classes.selected="{Binding IsSelected}" Classes.dim="{Binding !IsInstalled}" Margin="0,0,14,14"
                      Background="{Binding Tint}"
                      ToolTip.Tip="{Binding Name}"
                      Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                <Grid>
                  <!-- generated cover when no art is available -->
                  <Grid IsVisible="{Binding !HasCover}">
                    <Grid.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2A1650" Offset="0" />
                        <GradientStop Color="#120F1F" Offset="1" />
                      </LinearGradientBrush>
                    </Grid.Background>
                    <TextBlock Text="{Binding Genre}" FontSize="16" Opacity="0.5" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource HeadFont}" FontSize="44" FontWeight="Bold" Foreground="{StaticResource AccentLight}" Opacity="0.9"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0" />
                  </Grid>
                  <Image Source="{Binding Cover, Converter={x:Static local:CoverConverter.Instance}}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                  <Button Classes="star" Classes.on="{Binding IsFavorite}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                          ToolTip.Tip="{Binding [fav.tip], Source={x:Static loc:Loc.I}}"
                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ToggleFavoriteCommand}" CommandParameter="{Binding}">★</Button>
                  <Border VerticalAlignment="Bottom" Background="#B30B0A12" Padding="10,8">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="11" IsVisible="{Binding !IsInstalled}" Text="{Binding [home.notInstalled], Source={x:Static loc:Loc.I}}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</UserControl>
