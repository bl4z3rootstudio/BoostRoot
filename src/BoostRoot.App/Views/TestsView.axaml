<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BoostRoot.ViewModels" xmlns:loc="using:BoostRoot.ViewModels.Localization"
             x:Class="BoostRoot.App.Views.TestsView" x:DataType="vm:TestsViewModel" Focusable="True">
  <ScrollViewer>
    <StackPanel Margin="48,24" Spacing="16">
      <TextBlock Classes="h1" FontSize="32" Text="{Binding [tests.title], Source={x:Static loc:Loc.I}}" />
      <TextBlock Classes="muted" Text="{Binding [tests.sub], Source={x:Static loc:Loc.I}}" />
      <Grid ColumnDefinitions="2*,*">
        <Border Classes="card" Margin="0,0,12,0">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{Binding [tests.mouse], Source={x:Static loc:Loc.I}}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding [tests.mouseHow], Source={x:Static loc:Loc.I}}" />
            <Border x:Name="MousePad" Height="190" CornerRadius="12" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1" Cursor="Cross">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource HeadFont}" FontSize="54" FontWeight="Bold" Foreground="{StaticResource AccentLight}"><Run Text="{Binding MouseHz}" /><Run Text=" Hz" FontSize="22" /></TextBlock>
                <TextBlock HorizontalAlignment="Center" Classes="muted"><Run Text="{Binding [tests.peak], Source={x:Static loc:Loc.I}}" /><Run Text=": " /><Run Text="{Binding MousePeak}" /><Run Text=" Hz" /></TextBlock>
              </StackPanel>
            </Border>
            <TextBlock Classes="muted"><Run Text="{Binding [tests.clicks], Source={x:Static loc:Loc.I}}" /><Run Text=": " /><Run Text="{Binding Clicks}" Foreground="{StaticResource Text}" /></TextBlock>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{Binding [tests.monitor], Source={x:Static loc:Loc.I}}" />
            <TextBlock Classes="muted" Text="{Binding [tests.hz], Source={x:Static loc:Loc.I}}" />
            <TextBlock FontFamily="{StaticResource HeadFont}" FontSize="44" FontWeight="Bold"><Run Text="{Binding MonitorHz}" /><Run Text=" Hz" FontSize="20" /></TextBlock>
            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="{Binding [tests.deadPixel], Source={x:Static loc:Loc.I}}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding [tests.deadPixelHow], Source={x:Static loc:Loc.I}}" />
            <Button x:Name="DeadPixelButton" Classes="primary" HorizontalAlignment="Left" Content="{Binding [tests.start], Source={x:Static loc:Loc.I}}" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="h2" Text="{Binding [tests.keyboard], Source={x:Static loc:Loc.I}}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding [tests.keyboardHow], Source={x:Static loc:Loc.I}}" />
            </StackPanel>
            <Button x:Name="ResetButton" Grid.Column="1" Classes="ghost" VerticalAlignment="Top" Content="{Binding [tests.reset], Source={x:Static loc:Loc.I}}" />
          </Grid>
          <StackPanel x:Name="Keyboard" Spacing="6" FlowDirection="LeftToRight" />
          <StackPanel Orientation="Horizontal" Spacing="28">
            <TextBlock Classes="muted"><Run Text="{Binding [tests.keys], Source={x:Static loc:Loc.I}}" /><Run Text=": " /><Run Text="{Binding KeysTested}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /></TextBlock>
            <TextBlock Classes="muted"><Run Text="{Binding [tests.rollover], Source={x:Static loc:Loc.I}}" /><Run Text=": " /><Run Text="{Binding Rollover}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /></TextBlock>
            <TextBlock Classes="muted"><Run Text="{Binding [tests.last], Source={x:Static loc:Loc.I}}" /><Run Text=": " /><Run Text="{Binding LastKey}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /></TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
