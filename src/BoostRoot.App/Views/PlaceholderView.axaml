<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BoostRoot.ViewModels"
             x:Class="BoostRoot.App.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
  <StackPanel Margin="48,24" Spacing="10">
    <TextBlock Classes="h1" FontSize="32" Text="{Binding Title}" />
    <TextBlock Classes="muted" Text="{Binding Message}" />
  </StackPanel>
</UserControl>
