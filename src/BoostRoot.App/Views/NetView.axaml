<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BoostRoot.ViewModels" xmlns:loc="using:BoostRoot.ViewModels.Localization"
             x:Class="BoostRoot.App.Views.NetView" x:DataType="vm:NetViewModel">
  <ScrollViewer>
    <StackPanel Margin="48,24" Spacing="18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" FontSize="32" Text="{Binding [nav.net], Source={x:Static loc:Loc.I}}" />
          <TextBlock Classes="muted" Text="{Binding [net.note], Source={x:Static loc:Loc.I}}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" Command="{Binding RunCommand}" Content="{Binding [net.run], Source={x:Static loc:Loc.I}}" />
      </Grid>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <PathIcon Data="M12 4c4 0 7.6 1.6 10.3 4.2l-1.5 1.5A12.5 12.5 0 0 0 12 6a12.5 12.5 0 0 0-8.8 3.7L1.7 8.2A14.5 14.5 0 0 1 12 4zm0 5c2.6 0 5 1 6.7 2.8l-1.5 1.5A7.4 7.4 0 0 0 12 11a7.4 7.4 0 0 0-5.2 2.3l-1.5-1.5A9.4 9.4 0 0 1 12 9zm0 5c1.3 0 2.5.5 3.4 1.4L12 19l-3.4-3.6c.9-.9 2.1-1.4 3.4-1.4z" Width="22" Height="22" Foreground="{StaticResource AccentLight}" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Classes="h2" Text="{Binding [improve.title], Source={x:Static loc:Loc.I}}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding [improve.sub], Source={x:Static loc:Loc.I}}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center" Command="{Binding ImproveCommand}" IsEnabled="{Binding !Improving}" Content="{Binding [improve.run], Source={x:Static loc:Loc.I}}" />
          </Grid>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Improving}" Foreground="{StaticResource Accent}" />
          <ItemsControl ItemsSource="{Binding ImproveSteps}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                <PathIcon Data="M9.6 16.6 4.9 11.9l1.4-1.4 3.3 3.3 8.1-8.1 1.4 1.4z" Width="14" Height="14" Foreground="{StaticResource Good}" />
                <TextBlock TextWrapping="Wrap" MaxWidth="820" Text="{Binding}" />
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border IsVisible="{Binding DnsQuestion, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#1AFFFFFF" CornerRadius="8" Padding="12,10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding DnsQuestion}" />
              <Button Grid.Column="1" Classes="primary" Command="{Binding ApplyDnsCommand}" Content="{Binding [improve.yes], Source={x:Static loc:Loc.I}}" />
              <Button Grid.Column="2" Classes="ghost" Command="{Binding SkipDnsCommand}" Content="{Binding [improve.no], Source={x:Static loc:Loc.I}}" />
            </Grid>
          </Border>
          <Button Classes="ghost" HorizontalAlignment="Left" IsVisible="{Binding DnsChanged}" Command="{Binding RestoreDnsCommand}" Content="{Binding [improve.restore], Source={x:Static loc:Loc.I}}" />
        </StackPanel>
      </Border>
      <ProgressBar Value="{Binding Progress}" Maximum="1" IsVisible="{Binding IsRunning}" Foreground="{StaticResource Accent}" />
      <TextBlock Foreground="{StaticResource Bad}" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <UniformGrid Columns="3">
        <Border Classes="card" Margin="0,0,12,0"><StackPanel><TextBlock Classes="muted" Text="{Binding [net.download], Source={x:Static loc:Loc.I}}" /><TextBlock FontSize="26" FontWeight="Bold" Text="{Binding Download}" /></StackPanel></Border>
        <Border Classes="card" Margin="0,0,12,0"><StackPanel><TextBlock Classes="muted" Text="{Binding [net.upload], Source={x:Static loc:Loc.I}}" /><TextBlock FontSize="26" FontWeight="Bold" Text="{Binding Upload}" /></StackPanel></Border>
        <Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="{Binding [net.latency], Source={x:Static loc:Loc.I}}" /><TextBlock FontSize="26" FontWeight="Bold" Text="{Binding Latency}" /></StackPanel></Border>
      </UniformGrid>
      <TextBlock Classes="h2" Text="{Binding [net.servers], Source={x:Static loc:Loc.I}}" />
      <ItemsControl ItemsSource="{Binding Pings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PingRow">
            <Border Classes="card" Margin="0,0,0,8" Padding="14,10">
              <Grid ColumnDefinitions="*,120,120,90">
                <TextBlock><Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Region}" Foreground="{StaticResource Muted}" /></TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Avg}" />
                <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Jitter}" />
                <TextBlock Grid.Column="3" Text="{Binding Loss}" Foreground="{StaticResource Good}" IsVisible="{Binding Ok}" />
                <TextBlock Grid.Column="3" Text="{Binding Loss}" Foreground="{StaticResource Warn}" IsVisible="{Binding !Ok}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="h2" Text="{Binding [dns.title], Source={x:Static loc:Loc.I}}" />
              <TextBlock Classes="muted" FontSize="12" Text="{Binding [dns.note], Source={x:Static loc:Loc.I}}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Command="{Binding RunDnsCommand}" Content="{Binding [dns.run], Source={x:Static loc:Loc.I}}" />
          </Grid>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding DnsRunning}" Foreground="{StaticResource Accent}" />
          <ItemsControl ItemsSource="{Binding Dns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DnsRow">
                <Grid ColumnDefinitions="*,150,90" Margin="0,3">
                  <TextBlock><Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Address}" Foreground="{StaticResource Muted}" /></TextBlock>
                  <TextBlock Grid.Column="1" Classes="muted" Text="★" IsVisible="{Binding Best}" Foreground="{StaticResource Good}" />
                  <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding Ms}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AccentLight}" Text="{Binding DnsAdvice}" />
        </StackPanel>
      </Border>
      <TextBlock Classes="h2" Text="{Binding [net.advice], Source={x:Static loc:Loc.I}}" />
      <ItemsControl ItemsSource="{Binding Advice}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Background="#17122A" BorderBrush="#4C2F7A" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
              <TextBlock TextWrapping="Wrap" Text="{Binding}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
