<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BoostRoot.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BoostRoot/Theme/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#A855F7" AltHigh="#0B0912" RegionColor="#0B0912" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://BoostRoot/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
