<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>26.11.1</Version>
    <FileVersion>26.11.1.0</FileVersion>
    <AssemblyVersion>26.11.1.0</AssemblyVersion>
    <Company>bl4z3root</Company>
    <Product>BoostRoot</Product>
    <Copyright>bl4z3root</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('/src/')) Or $(MSBuildProjectDirectory.Contains('\src\'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
