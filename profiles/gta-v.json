      "set": {
        "xml:Settings/graphics/MotionBlurStrength@value": "0.000000"
      },
      "gpu": {
        "lowLatency": true,
        "vSync": false,
        "radeonBoost": false
      }
    },
    "balanced": {
      "set": {
        "xml:Settings/graphics/Tessellation@value": "1",
