        "xml:Settings/graphics/PostFX@value": "0",
        "xml:Settings/graphics/Shadow_SoftShadows@value": "0",
        "xml:Settings/graphics/UltraShadows_Enabled@value": "false",
        "xml:Settings/graphics/DoF@value": "false",
        "xml:Settings/graphics/MotionBlurStrength@value": "0.000000"
      },
      "gpu": {
        "lowLatency": true,
        "vSync": false,
        "radeonBoost": true,
        "upscaler": "quality"
