      "set": {
        "gus:ScalabilityGroups/sg.ViewDistanceQuality": "3",
        "gus:ScalabilityGroups/sg.AntiAliasingQuality": "2",
        "gus:ScalabilityGroups/sg.ShadowQuality": "2",
        "gus:ScalabilityGroups/sg.GlobalIlluminationQuality": "3",
        "gus:ScalabilityGroups/sg.ReflectionQuality": "3",
        "gus:ScalabilityGroups/sg.PostProcessQuality": "2",
        "gus:ScalabilityGroups/sg.TextureQuality": "3",
        "gus:ScalabilityGroups/sg.EffectsQuality": "2",
        "gus:ScalabilityGroups/sg.FoliageQuality": "3",
        "gus:ScalabilityGroups/sg.ShadingQuality": "3"
      },
      "gpu": {
        "lowLatency": true,
        "vSync": false,
        "radeonBoost": false
      }
    },
    "balanced": {
      "set": {
        "gus:ScalabilityGroups/sg.ViewDistanceQuality": "2",
        "gus:ScalabilityGroups/sg.AntiAliasingQuality": "2",
        "gus:ScalabilityGroups/sg.ShadowQuality": "2",
        "gus:ScalabilityGroups/sg.GlobalIlluminationQuality": "2",
        "gus:ScalabilityGroups/sg.ReflectionQuality": "2",
        "gus:ScalabilityGroups/sg.PostProcessQuality": "2",
        "gus:ScalabilityGroups/sg.TextureQuality": "2",
        "gus:ScalabilityGroups/sg.EffectsQuality": "2",
        "gus:ScalabilityGroups/sg.FoliageQuality": "2",
        "gus:ScalabilityGroups/sg.ShadingQuality": "2"
      },
      "gpu": {
        "lowLatency": true,
        "vSync": false,
        "radeonBoost": true
      }
    },
    "maxfps": {
      "set": {
        "gus:ScalabilityGroups/sg.ViewDistanceQuality": "0",
        "gus:ScalabilityGroups/sg.AntiAliasingQuality": "0",
        "gus:ScalabilityGroups/sg.ShadowQuality": "0",
        "gus:ScalabilityGroups/sg.GlobalIlluminationQuality": "0",
        "gus:ScalabilityGroups/sg.ReflectionQuality": "0",
        "gus:ScalabilityGroups/sg.PostProcessQuality": "0",
        "gus:ScalabilityGroups/sg.TextureQuality": "0",
        "gus:ScalabilityGroups/sg.EffectsQuality": "0",
        "gus:ScalabilityGroups/sg.FoliageQuality": "0",
