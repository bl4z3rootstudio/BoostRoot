{
  "id": "palworld",
  "name": "Palworld",
  "schemaVersion": 1,
  "antiCheat": "none",
  "competitive": false,
  "group": "A",
  "detect": {
    "steam": "1623730",
    "process": "Palworld-Win64-Shipping.exe"
  },
  "launch": {
    "steam": "1623730"
  },
  "configs": [
    {
      "id": "gus",
      "format": "ini",
      "path": "%LOCALAPPDATA%/Pal/Saved/Config/Windows/GameUserSettings.ini"
    }
