; BoostRoot Poligon — aim trainer with game-exact sensitivity.
config_version=5

[application]
config/name="BoostRoot Poligon"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0
boot_splash/show_image=false
boot_splash/bg_color=Color(0.04, 0.04, 0.07, 1)
config/use_custom_user_dir=true
config/custom_user_dir_name="BoostRootPoligon"

[autoload]
Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/vsync/vsync_mode=0
window/energy_saving/keep_screen_on=true

[input_devices]
pointing/emulate_touch_from_mouse=false
buffering/agile_event_flushing=true

[physics]
common/physics_ticks_per_second=128
common/max_physics_steps_per_frame=16

[rendering]
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
textures/default_filters/anisotropic_filtering_level=2
